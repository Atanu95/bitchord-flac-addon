{
  "id": "bitchord-internet-archive-flac",
  "name": "Layz Add On",
  "version": "1.15.3",
  "resources": [
    "search",
    "stream"
  ],
  "bitchordAuth": true,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "hires",
      "options": [
        {
          "label": "Best Available (Hi-Res first, FLAC fallback)",
          "value": "hires"
        },
        {
          "label": "Lossless FLAC (any resolution)",
          "value": "lossless"
        }
      ]
    },
    {
      "key": "source",
      "type": "select",
      "default": "all",
      "options": [
        {
          "label": "All FLAC Sources",
          "value": "all"
        },
        {
          "label": "Internet Archive",
          "value": "archive"
        },
        {
          "label": "Jamendo",
          "value": "jamendo"
        }
      ]
    },
    {
      "key": "genre",
      "type": "select",
      "default": "all",
      "options": [
        {
          "label": "All Music",
          "value": "all"
        },
        {
          "label": "Bollywood (2008–2026)",
          "value": "bollywood"
        },
        {
          "label": "English (All Genres, 2000–2026)",
          "value": "english"
        }
      ]
    }
  ]
}
